# Copy this file to config.env, fill in your values and load it in every new terminal:
#   cp config.env.example config.env
#   source config.env
#
# Same values as in the GCP Project Setup session (you can copy ALIAS, PROJECT_ID and
# PROJECT_NUMBER from the config.env you used there).

# ALIAS: your short, lowercase identifier (letters, digits and hyphens only), e.g. "jgarcia".
export ALIAS="changeme"

# PROJECT_ID: the project EDEM gave you, e.g. "edem-p17".
export PROJECT_ID="changeme"

# PROJECT_NUMBER: gcloud projects describe "$PROJECT_ID" --format="value(projectNumber)"
export PROJECT_NUMBER=""

export ENV="dev"
export REGION="europe-southwest1"            # Madrid
export ZONE="europe-southwest1-a"
export FAR_REGION="asia-northeast1"          # Tokyo, used in Lab 4 to measure latency
export AR_REPO="ecommerce"

# Lab 2.2: paste the URL of your orders-api here once it is deployed
export ORDERS_API_URL=""

# Derived values - do not edit
export REGISTRY="${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}"
export SA_DEFAULT="${PROJECT_NUMBER}-compute@developer.gserviceaccount.com"   # default compute SA (Editor)
export LABELS="env=${ENV},owner=${ALIAS},course=edem-mdia"
